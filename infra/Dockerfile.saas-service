# Generic Dockerfile for building & running any app in the monorepo
# Usage: pass build-arg APP_NAME with the app folder name under apps/ (e.g., svc-order)
# Example:
#   docker build -f Dockerfile.saas-service --build-arg APP_NAME=orchestrator -t orchestrator .
#   docker run --rm --network=host orchestrator
#
# Works with docker-compose.apps.yml where each service sets APP_NAME.

FROM node:20-alpine AS build
WORKDIR /app

# Tooling
RUN corepack enable && apk add --no-cache libc6-compat python3 make g++

# Copy workspace manifests for better caching
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./

# Copy sources (adjust if your repo layout differs)
COPY apps ./apps
COPY packages ./packages

# Install deps recursively for the whole workspace
RUN pnpm install -r --frozen-lockfile

# Build the selected app
ARG APP_NAME
RUN test -n "$APP_NAME" || (echo 'APP_NAME build-arg is required' && exit 1)
RUN pnpm -F ${APP_NAME} build

# Try Prisma client/migrations if the app has Prisma (no-fail if absent)
RUN pnpm -F ${APP_NAME} exec -- prisma generate || true
RUN pnpm -F ${APP_NAME} exec -- prisma migrate deploy || true

# ---------- Runtime ----------
FROM node:20-alpine AS runner
WORKDIR /app
RUN corepack enable
ENV NODE_ENV=production

# copy full workspace so runtime can resolve local packages without publishing
COPY --from=build /app /app

# Expose common HTTP port (optional — uncomment per app or map in compose)
# EXPOSE 3000

ARG APP_NAME
ENV APP_NAME=${APP_NAME}

# Start the built app
CMD ["sh", "-lc", "node apps/${APP_NAME}/dist/main.js"]
